
@article{osipjan_graphtrace_2025,
	title = {{GraphTrace}: {A} {Modular} {Retrieval} {Framework} {Combining} {Knowledge} {Graphs} and {Large} {Language} {Models} for {Multi}-{Hop} {Question} {Answering}},
	volume = {14},
	copyright = {https://creativecommons.org/licenses/by/3.0/},
	issn = {2073-431X},
	shorttitle = {{GraphTrace}},
	url = {https://www.mdpi.com/2073-431X/14/9/382},
	doi = {10.3390/computers14090382},
	abstract = {This paper introduces GraphTrace, a novel retrieval framework that integrates a domain-specific knowledge graph (KG) with a large language model (LLM) to improve information retrieval for complex, multi-hop queries. Built on structured economic data related to the COVID-19 pandemic, GraphTrace adopts a modular architecture comprising entity extraction, path finding, query decomposition, semantic path ranking, and context aggregation, followed by LLM-based answer generation. GraphTrace is compared against baseline retrieval-augmented generation (RAG) and graph-based RAG (GraphRAG) approaches in both retrieval and generation settings. Experimental results show that GraphTrace consistently outperforms the baselines across evaluation metrics, particularly in handling mid-complexity (5–6-hop) queries and achieving top scores in directness during the generation evaluation. These gains are attributed to GraphTrace’s alignment of semantic reasoning with structured KG traversal, combining modular components for more targeted and interpretable retrieval.},
	language = {en},
	number = {9},
	urldate = {2026-11-03},
	journal = {Computers},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Osipjan, Anna and Khorashadizadeh, Hanieh and Kessel, Akasha-Leonie and Groppe, Sven and Groppe, Jinghua},
	month = sep,
	year = {2025},
	keywords = {GraphRAG, knowledge graph, large language model, retrieval augmented generation},
	pages = {382},
	annote = {Probably Relevant
},
	annote = {Starting paper},
	file = {Full Text PDF:/home/ltschneefall/Zotero/storage/62AQER88/Osipjan et al. - 2025 - GraphTrace A Modular Retrieval Framework Combining Knowledge Graphs and Large Language Models for M.pdf:application/pdf},
}

@inproceedings{khorashadizadeh_construction_2025,
	address = {Cham},
	title = {Construction and {Canonicalization} of {Economic} {Knowledge} {Graphs} with {LLMs}},
	isbn = {978-3-031-81221-7},
	doi = {10.1007/978-3-031-81221-7_23},
	abstract = {Ontology-based knowledge graphs, such as YAGO and Wikidata, rely on pre-defined schemas to organize and connect information. While effective, these systems are inherently domain-specific, requiring tailored ontologies that are costly, time-consuming, and demand expert knowledge to develop. To address these limitations, Open Information Extraction (OpenIE) offers a complementary approach by extracting structured information directly from unstructured text without needing a predefined schema. However, OpenIE results in a vast number of relations, often leading to redundancy and inconsistencies. To overcome this, we propose a novel approach that leverages Large Language Models (LLMs) for constructing a knowledge graph and for canonicalizing relations within it. Our method includes generating question-answer pairs from text, extracting triples from these pairs, and applying a two-step canonicalization process to ensure consistency and reduce redundancy. This paper presents our approach in detail, exploring related work, the construction of the knowledge graph, the canonicalization process, and the evaluation of our methods.},
	language = {en},
	booktitle = {Knowledge {Graphs} and {Semantic} {Web}},
	publisher = {Springer Nature Switzerland},
	author = {Khorashadizadeh, Hanieh and Mihindukulasooriya, Nandana and Ranji, Nilufar and Ezzabady, Morteza and Ieng, Frédéric and Groppe, Jinghua and Benamara, Farah and Groppe, Sven},
	editor = {Tiwari, Sanju and Villazón-Terrazas, Boris and Ortiz-Rodríguez, Fernando and Sahri, Soror},
	year = {2025},
	keywords = {Canonicalization, Knowledge Graph, Large Language Model, Open Information Extraction},
	pages = {334--343},
}

@misc{wu_kg-traces_2025,
	title = {{KG}-{TRACES}: {Enhancing} {Large} {Language} {Models} with {Knowledge} {Graph}-constrained {Trajectory} {Reasoning} and {Attribution} {Supervision}},
	shorttitle = {{KG}-{TRACES}},
	url = {http://arxiv.org/abs/2506.00783},
	doi = {10.48550/arXiv.2506.00783},
	abstract = {Large language models (LLMs) have made remarkable strides in various natural language processing tasks, but their performance on complex reasoning problems remains hindered by a lack of explainability and trustworthiness. This issue, often manifesting as hallucinations or unattributable reasoning processes, limits their applicability in complex reasoning scenarios. To address this, we propose Knowledge Graph-constrained Trajectory Reasoning Attribution and Chain Explanation Supervision (KG-TRACES), a novel framework that enhances the reasoning ability of LLMs through explicit supervision over reasoning paths and processes. KG-TRACES jointly supervises the model to: (1) predict symbolic relation paths, (2) predict full triple-level reasoning paths, and (3) generate attribution-aware reasoning processes grounded in the reasoning paths. At inference phase, the model adapts to both KG-available and KG-unavailable scenarios, retrieving reasoning paths from a KG when possible or predicting plausible reasoning paths with only intrinsic knowledge when not. This design enables the model to reason in an explainable and source-attributable pattern. Through extensive experiments on complex reasoning tasks, we demonstrate that KG-TRACES significantly outperforms existing SOTA: it improves Hits@1 by 1.6\% and F1 by 4.7\% on WebQSP, and achieves improvements of 4.8\% in Hits@1 and 2.1\% in F1 on CWQ. Moreover, we show its transferability to specialized domains such as medicine. By visualizing the intermediate steps of reasoning processes, we further show that the explicit supervision introduced by KG-TRACES leads to more stable and goal-directed reasoning processes, aligning closely with correct answers. Code is available at https://github.com/Edaizi/KG-TRACES.},
	urldate = {2026-11-14},
	publisher = {arXiv},
	author = {Wu, Rong and Cai, Pinlong and Mei, Jianbiao and Wen, Licheng and Hu, Tao and Yang, Xuemeng and Fu, Daocheng and Shi, Botian},
	month = oct,
	year = {2025},
	note = {arXiv:2506.00783 [cs.CL]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Computation and Language},
	annote = {Comment: 24 pages, 13 figures},
	annote = {KG-Traces},
	file = {Preprint PDF:/home/ltschneefall/Zotero/storage/RD4H2H6N/Wu et al. - 2025 - KG-TRACES Enhancing Large Language Models with Knowledge Graph-constrained Trajectory Reasoning and.pdf:application/pdf;Snapshot:/home/ltschneefall/Zotero/storage/3R4FTIJ7/2506.html:text/html},
}

@misc{sun_clearing_2026,
	title = {Clearing the {FoG}: {Training} {KG} {Agents} to {Retrieve} the {Evidence} {Behind} {Their} {Answers}},
	shorttitle = {Clearing the {FoG}},
	url = {http://arxiv.org/abs/2610.37405},
	doi = {10.48550/arXiv.2610.37405},
	abstract = {Large language models (LLMs) can answer many factual questions correctly, but a correct answer is not necessarily a supported one. For an LLM agent, a knowledge graph (KG) plays two roles: as a source of answers, it supplies facts that the model lacks; as a source of evidence, it supplies the supporting triples that make an answer traceable and auditable. However, existing KG agents treat the KG only as a source of answers: their training data carries answers but not evidence, and their training rewards check the answer but not the retrieved evidence, so agents often answer correctly without retrieving the supporting triples. We propose FoG, a framework that trains KG agents to retrieve the evidence behind their answers. FoG consists of evidence-grounded synthesis, a KG interaction agent, and an evidence-coverage process reward (ECPR): the synthesis recursively hides explicit entities behind verifiable sub-questions, so that every question carries its supporting triples by construction; the agent records the triples returned by the KG; and ECPR credits each supporting triple to the turn that first retrieves it. Experiments on three KGQA benchmarks demonstrate that FoG enables 3B--4B open-source agents to outperform substantially larger baselines in answer accuracy and evidence coverage, with zero-shot cross-KG transfer.},
	urldate = {2026-11-14},
	publisher = {arXiv},
	author = {Sun, Zongyuan and Zhao, Shuai and Du, Yingjun and Shu, Ke and Zhu, Ziyue and Luo, Haoran},
	month = oct,
	year = {2026},
	note = {arXiv:2610.37405 [cs.AI]},
	keywords = {Computer Science - Artificial Intelligence},
	annote = {Evidencing},
	file = {Preprint PDF:/home/ltschneefall/Zotero/storage/58GZMB6X/Sun et al. - 2026 - Clearing the FoG Training KG Agents to Retrieve the Evidence Behind Their Answers.pdf:application/pdf;Snapshot:/home/ltschneefall/Zotero/storage/GWD5CVWW/2610.html:text/html},
}

@misc{amrani_graphragprov_2026,
	title = {{GraphRAGProv}: {GraphRAG} {Meets} {How}-{Provenance}},
	shorttitle = {{GraphRAGProv}},
	url = {http://arxiv.org/abs/2610.37237},
	doi = {10.48550/arXiv.2610.37237},
	abstract = {GraphRAG systems often use knowledge graphs to retrieve relevant context for an LLM that produces the final answer. That makes answers more inscrutable and therefore less appealing for domains where transparency is paramount. We present GraphRAGProv, an architecture that executes SPARQL queries over source-grounded RDF graphs to compute answers and their how-provenance polynomials. These polynomials record which statement occurrences were used and how they were combined. Because each occurrence is linked to its source text, users can follow these links to check whether the extracted statements reflect the text and whether the query combines them to answer the question. Querying thereby becomes a way to inspect and evaluate the text-to-graph transformation. Our interactive demo examines 400 cases from two multi-hop QA benchmarks, revealing extraction and query errors even when the final answer is correct.},
	urldate = {2026-11-14},
	publisher = {arXiv},
	author = {Amrani, Wadie El and Galárraga, Luis},
	month = oct,
	year = {2026},
	note = {arXiv:2610.37237 [cs.AI]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Databases},
	annote = {GraphReg on rdf},
	file = {Preprint PDF:/home/ltschneefall/Zotero/storage/ZHLMJBA2/Amrani and Galárraga - 2026 - GraphRAGProv GraphRAG Meets How-Provenance.pdf:application/pdf;Snapshot:/home/ltschneefall/Zotero/storage/AMNL23X2/2610.html:text/html},
}

@misc{yang_prospector_2026,
	title = {Prospector: learning a compact graph traversal policy for scientific reasoning},
	shorttitle = {Prospector},
	url = {http://arxiv.org/abs/2610.37121},
	doi = {10.48550/arXiv.2610.37121},
	abstract = {Scientific reasoning in specialized engineering fields depends on knowledge scattered across the literature, often proprietary and absent from frontier LLM training data. In such domains, frontier models tend to give generic answers. Knowledge graphs (KGs) can ground LLM reasoning. Because a graph is too large to provide in full, typical LLM+KG systems preselect a portion, deciding relevance before reasoning begins. Here we train a compact model, Prospector, to reason over a domain knowledge graph by traversing it step by step, seeking evidence in light of what it has already found. Prospector calls a small set of tools one at a time to progressively build its context, and answers with a chain of evidence that can be checked edge by edge against what its tools retrieved from the graph. On a knowledge graph built from the semiconductor-manufacturing literature, Prospector approaches the strongest off-the-shelf models given the same graph and tools, and it far exceeds off-the-shelf models answering closed-book or from a pre-selected portion of the graph. Although trained only on the semiconductor graph, Prospector transfers to unseen knowledge graphs from three other distinct fields: bio-inspired materials, per- and polyfluoroalkyl substances (PFAS) and materials properties. Served on a single GPU, Prospector answers faster and at a fraction of the cost of a hosted service, while keeping proprietary data on the owner's hardware. We find that the policy's latent state is indicative of its next move on both seen and unseen graphs, and modulating the latent state can steer the policy from one behavior mode to another. These results suggest a practical LLM + KG paradigm for scientific and engineering reasoning over private data, in which a compact model trained on a graph from published literature transfers its traversal to unseen graphs that stay with their owners.},
	urldate = {2026-11-14},
	publisher = {arXiv},
	author = {Yang, Haiqian and Buehler, Markus J.},
	month = oct,
	year = {2026},
	note = {arXiv:2610.37121 [cs.AI]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Computation and Language, Computer Science - Machine Learning, Condensed Matter - Materials Science},
	annote = {Evidencing},
	file = {Preprint PDF:/home/ltschneefall/Zotero/storage/6BYMB768/Yang and Buehler - 2026 - Prospector learning a compact graph traversal policy for scientific reasoning.pdf:application/pdf;Snapshot:/home/ltschneefall/Zotero/storage/PYPQ2SGE/2610.html:text/html},
}

@misc{zhu_llms_2024,
	title = {{LLMs} for {Knowledge} {Graph} {Construction} and {Reasoning}: {Recent} {Capabilities} and {Future} {Opportunities}},
	shorttitle = {{LLMs} for {Knowledge} {Graph} {Construction} and {Reasoning}},
	url = {http://arxiv.org/abs/2305.13168},
	doi = {10.48550/arXiv.2305.13168},
	abstract = {This paper presents an exhaustive quantitative and qualitative evaluation of Large Language Models (LLMs) for Knowledge Graph (KG) construction and reasoning. We engage in experiments across eight diverse datasets, focusing on four representative tasks encompassing entity and relation extraction, event extraction, link prediction, and question-answering, thereby thoroughly exploring LLMs' performance in the domain of construction and inference. Empirically, our findings suggest that LLMs, represented by GPT-4, are more suited as inference assistants rather than few-shot information extractors. Specifically, while GPT-4 exhibits good performance in tasks related to KG construction, it excels further in reasoning tasks, surpassing fine-tuned models in certain cases. Moreover, our investigation extends to the potential generalization ability of LLMs for information extraction, leading to the proposition of a Virtual Knowledge Extraction task and the development of the corresponding VINE dataset. Based on these empirical findings, we further propose AutoKG, a multi-agent-based approach employing LLMs and external sources for KG construction and reasoning. We anticipate that this research can provide invaluable insights for future undertakings in the field of knowledge graphs. The code and datasets are in https://github.com/zjunlp/AutoKG.},
	urldate = {2026-11-14},
	publisher = {arXiv},
	author = {Zhu, Yuqi and Wang, Xiaohan and Chen, Jing and Qiao, Shuofei and Ou, Yixin and Yao, Yunzhi and Deng, Shumin and Chen, Huajun and Zhang, Ningyu},
	month = dec,
	year = {2024},
	note = {arXiv:2305.13168 [cs.CL]},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Computation and Language, Computer Science - Databases, Computer Science - Machine Learning, Computer Science - Information Retrieval},
	annote = {Comment: World Wide Web Journal},
	annote = {Outdated},
	file = {Preprint PDF:/home/ltschneefall/Zotero/storage/LT4EFCBF/Zhu et al. - 2024 - LLMs for Knowledge Graph Construction and Reasoning Recent Capabilities and Future Opportunities.pdf:application/pdf;Snapshot:/home/ltschneefall/Zotero/storage/YP45GBP6/2305.html:text/html},
}

@misc{kau_combining_2024,
	title = {Combining {Knowledge} {Graphs} and {Large} {Language} {Models}},
	url = {http://arxiv.org/abs/2407.06564},
	doi = {10.48550/arXiv.2407.06564},
	abstract = {In recent years, Natural Language Processing (NLP) has played a significant role in various Artificial Intelligence (AI) applications such as chatbots, text generation, and language translation. The emergence of large language models (LLMs) has greatly improved the performance of these applications, showing astonishing results in language understanding and generation. However, they still show some disadvantages, such as hallucinations and lack of domain-specific knowledge, that affect their performance in real-world tasks. These issues can be effectively mitigated by incorporating knowledge graphs (KGs), which organise information in structured formats that capture relationships between entities in a versatile and interpretable fashion. Likewise, the construction and validation of KGs present challenges that LLMs can help resolve. The complementary relationship between LLMs and KGs has led to a trend that combines these technologies to achieve trustworthy results. This work collected 28 papers outlining methods for KG-powered LLMs, LLM-based KGs, and LLM-KG hybrid approaches. We systematically analysed and compared these approaches to provide a comprehensive overview highlighting key trends, innovative techniques, and common challenges. This synthesis will benefit researchers new to the field and those seeking to deepen their understanding of how KGs and LLMs can be effectively combined to enhance AI applications capabilities.},
	urldate = {2026-11-14},
	publisher = {arXiv},
	author = {Kau, Amanda and He, Xuzeng and Nambissan, Aishwarya and Astudillo, Aland and Yin, Hui and Aryani, Amir},
	month = jul,
	year = {2024},
	note = {arXiv:2407.06564 [cs.CL]
version: 1},
	keywords = {Computer Science - Artificial Intelligence, Computer Science - Computation and Language},
	annote = {Collective, Outdated, not relevant
},
