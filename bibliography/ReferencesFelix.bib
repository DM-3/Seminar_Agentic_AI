@misc{zhao_unigfm-rag_2026,
	title = {{UniGFM}-{RAG}: {Unify} {Graph} {Foundation} {Models} and {Large} {Language} {Models} for {End}-to-{End} {Retrieval} and {Reasoning}},
	shorttitle = {{UniGFM}-{RAG}},
	url = {http://arxiv.org/abs/2610.34866},
	doi = {10.48550/arXiv.2610.34866},
	abstract = {Large Language Models (LLMs) have shown remarkable capabilities across tasks, but they still struggle with complex reasoning that requires integrating scattered knowledge. Graph Retrieval-Augmented Generation (GraphRAG) addresses this challenge by organizing fragment knowledge as graphs, while recent Graph Foundation Models (GFMs) further improve GraphRAG with graph-native retrieval and reasoning capabilities. However, existing GraphRAG methods usually adopt decoupled retrieve-then-generate pipelines, which create objective misalignment between retrieval and reasoning, and training GFM retrievers typically depends on expensive human annotations. To address these limitations, we propose {\textbackslash}ourmethod, a unified end-to-end GraphRAG framework that tightly couples a GFM retriever with an LLM generator. Given a query, the GFM retriever first reasons over the graph to score and retrieve relevant document nodes. These node embeddings are then passed through a fully differentiable graph bridge, which projects them into soft-weighted graph prefixes according to retrieval scores and combines them with raw document texts to form graph-augmented prompts. In this way, structural information is injected directly into LLM generation, while the final answer loss can be back-propagated through the bridge to jointly optimize retrieval and reasoning. To stabilize training and reduce reliance on costly annotations, we further introduce a semantic-guided distillation module that provides auxiliary supervision using pseudo-labels derived from query-document semantic similarities. Extensive experiments on three multi-hop QA datasets and three out-of-domain GraphRAG benchmarks show that {\textbackslash}ourmethod consistently outperforms strong baseline methods and generalizes well, which demonstrates the effectiveness of end-to-end GraphRAG with tightly integrated GFM retrieval and LLM reasoning.},
	urldate = {2026-11-14},
	publisher = {arXiv},
	author = {Zhao, Zicheng and Luo, Linhao and Yu, Zongji and Dong, Junnan and Tan, Yanchao and Pan, Shirui and Gong, Chen},
	month = oct,
	year = {2026},
	note = {arXiv:2610.34866 [cs.AI]},
	keywords = {Computer Science - Artificial Intelligence},
	annote = {Comment: 16 pages, 8 figures},
	file = {Preprint PDF:/home/ltschneefall/Zotero/storage/F2Y4MPY4/Zhao et al. - 2026 - UniGFM-RAG Unify Graph Foundation Models and Large Language Models for End-to-End Retrieval and Rea.pdf:application/pdf;Snapshot:/home/ltschneefall/Zotero/storage/NYZ3QSGN/2610.html:text/html},
