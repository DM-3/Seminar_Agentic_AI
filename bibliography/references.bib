@Article{GraphTrace2025,
  author         = {Osipjan, Anna and Khorashadizadeh, Hanieh and Kessel, Akasha-Leonie and Groppe, Sven and Groppe, Jinghua},
  journal        = {Computers},
  title          = {GraphTrace: A Modular Retrieval Framework Combining Knowledge Graphs and Large Language Models for Multi-Hop Question Answering},
  year           = {2025},
  issn           = {2073-431X},
  number         = {9},
  volume         = {14},
  abstract       = {This paper introduces GraphTrace, a novel retrieval framework that integrates a domain-specific knowledge graph (KG) with a large language model (LLM) to improve information retrieval for complex, multi-hop queries. Built on structured economic data related to the COVID-19 pandemic, GraphTrace adopts a modular architecture comprising entity extraction, path finding, query decomposition, semantic path ranking, and context aggregation, followed by LLM-based answer generation. GraphTrace is compared against baseline retrieval-augmented generation (RAG) and graph-based RAG (GraphRAG) approaches in both retrieval and generation settings. Experimental results show that GraphTrace consistently outperforms the baselines across evaluation metrics, particularly in handling mid-complexity (5–6-hop) queries and achieving top scores in directness during the generation evaluation. These gains are attributed to GraphTrace’s alignment of semantic reasoning with structured KG traversal, combining modular components for more targeted and interpretable retrieval.},
  article-number = {382},
  doi            = {10.3390/computers14090382},
  url            = {https://www.mdpi.com/2073-431X/14/9/382},
}

@Comment{
  1 Why Reviewed:
    introduction of GraphTrace

  2 Reviewed Sections:
    abstract, chapter 1-3

  3 Goal / Research Question:
    improve information retrieval for complex, multi-hop queries through GraphTrace framework

  4 Methodology / Technologies / System:
    User Query $->$ Query Decomposition
    User Query $->$ Entity Extraction $->$ Path Finding
    Query Decomposition + Path Finding $->$ Path Ranking $->$ Aggregation

    - entity extraction: 
        gpt-4o-mini with system prompt to output entities as JSON
    - path finding: 
        entities matched to nodes, #raw("allShortestPaths")
    - query decomposition: 
        all-MiniLM-L6-v2 with system prompt to output subquerries as JSON
    - semantic path ranking: 
        compute relevance score for each (subquery, path) pair, using ms-marco-MiniLM-L-6-v2 CrossEncoder
    - context aggregation
    - LLM-based answer generation

  5 Evaluation Methodology:
    tested in both retrieval and generation settings
    - retrieval augmented generation (RAG)
    - graph-based RAG (knowledge graphs + RAG)

    Dataset: "Knowledge graph about the impacts of the COVID-19 pandemic on the economy"
    - constructed from 62 reports and economic bulletins by organizations such as World Bank, IMF, European Central Bank
    - use LLM-generated question-answer pairs for triple extraction and entity linking via wikidata
    - 30000 triples

  6 Results:
    - outperforms baseline across evaluation metrics
    - gains attributed to alignment of semantic reasoning with structured KG traversal $->$ more targeted and interpretable retrieval

  7 Relevance:
    main reference
}

